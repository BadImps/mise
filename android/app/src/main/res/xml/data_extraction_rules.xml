<?xml version="1.0" encoding="utf-8"?>
<!-- Mise keeps saved recipes in app-private storage. Nothing is copied to
     cloud backup or device-to-device transfer by the platform. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
